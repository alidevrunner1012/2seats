    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/client": "^6.2.1",
    "@sentry/node": "^11.9.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/dockerode": "^4.0.2",
    "argon2": "^0.45.1",
