# Runtime configuration
NODE_ENV=development
PORT=3001

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://2seats:2seats_dev@localhost:5432/2seats?schema=public

# Redis connection used for shared application state
REDIS_URL=redis://localhost:6379

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# MinIO-compatible object storage (local development defaults match Compose)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=2seats_dev
MINIO_SECRET_KEY=2seats_dev_secret
MINIO_BUCKET=2seats-uploads

# HMAC signing key for 15-minute access tokens; use a unique random value of at least 32 characters outside development
JWT_ACCESS_SECRET=dev-only-change-this-access-signing-key-2seats

# Google OAuth web application client ID; leave empty with the secret to disable Google sign-in
GOOGLE_CLIENT_ID=
# Google OAuth web application client secret; configure together with the client ID
GOOGLE_CLIENT_SECRET=

# Public web application URL used to build verification and password-reset links
APP_URL=http://localhost:3000

# Sender address for verification and password-reset emails
MAIL_FROM=hello@2seats.local
# Resend API key; prefer this provider, or configure SMTP below
RESEND_API_KEY=
# SMTP server hostname; leave empty to use Resend or the development console fallback
SMTP_HOST=
# SMTP server port (typically 587 for STARTTLS or 465 for implicit TLS)
SMTP_PORT=587
# SMTP username; configure together with SMTP_PASSWORD when authentication is required
SMTP_USER=
# SMTP password; configure together with SMTP_USER when authentication is required
SMTP_PASSWORD=

# LiveKit server URL and API credentials used for token generation and webhooks
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
# Public DNS name and IP used by coturn for TURN over TLS fallback
TURN_DOMAIN=turn.localhost
TURN_PUBLIC_IP=127.0.0.1
