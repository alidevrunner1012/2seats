# Public API base URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public website origin used for canonical, sitemap, and social-sharing URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google OAuth web client ID (Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional browser-side Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=

# Optional server-side Sentry DSN (same project is fine)
SENTRY_DSN=

# Optional source-map upload settings for production builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
